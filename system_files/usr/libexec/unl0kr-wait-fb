#!/bin/sh
# simpledrm's /dev/fb0 vanishes when amdgpu takes over, which would leave
# unl0kr drawing into a dead framebuffer; give the real driver up to 10s.
i=0
while [ "$i" -lt 100 ]; do
    case "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" in
        "" | simpledrm*) ;;
        *) exit 0 ;;
    esac
    sleep 0.1
    i=$((i + 1))
done
exit 0
