From cf0940e1303c5761bc5e3bae98f4e291b6fad9f7 Mon Sep 17 00:00:00 2001
From: erdii <claude@erdii.net>
Date: Mon, 12 Oct 2026 20:50:13 +0200
Subject: [PATCH] feat(unl0kr): rotate the UI according to
 /sys/class/graphics/fbcon/rotate

On panels mounted sideways (e.g. Steam Deck) the kernel derives the console
rotation from the DRM panel orientation property. Apply the same rotation
when using the fbdev backend, which rotates in software. This mirrors what
buffyboard does since !60 and addresses #14 for the fbdev backend.
---
 shared/display.c | 40 ++++++++++++++++++++++++++++++++++++++++
 shared/display.h |  9 +++++++++
 unl0kr/main.c    |  7 +++++++
 3 files changed, 56 insertions(+)

diff --git a/shared/display.c b/shared/display.c
index df855e8..ef2758f 100644
--- a/shared/display.c
+++ b/shared/display.c
@@ -6,6 +6,7 @@
 #include "display.h"
 #include "log.h"
 
+#include <fcntl.h>
 #include <stdio.h>
 #include <stdbool.h>
 #include <unistd.h>
@@ -101,3 +102,42 @@ lv_display_t *bbx_display_create(bbx_backends_backend_id_t backend_id, bbx_displ
 
     return disp;
 }
+
+lv_display_rotation_t bbx_display_get_fbcon_rotation(void) {
+    lv_display_rotation_t rotation = LV_DISPLAY_ROTATION_0;
+
+    int fd = open("/sys/class/graphics/fbcon/rotate", O_RDONLY);
+    if (fd < 0) {
+        bbx_log(BBX_LOG_LEVEL_WARNING, "Can not open /sys/class/graphics/fbcon/rotate");
+        return rotation;
+    }
+
+    char buffer[3];
+    int size = read(fd, buffer, sizeof(buffer));
+    close(fd);
+    if (size != 2 || buffer[1] != '\n') {
+        bbx_log(BBX_LOG_LEVEL_WARNING, "Unexpected value of /sys/class/graphics/fbcon/rotate");
+        return rotation;
+    }
+
+    /* fbcon counts clockwise, LVGL counts counterclockwise */
+    switch (buffer[0]) {
+    case '0':
+        rotation = LV_DISPLAY_ROTATION_0;
+        break;
+    case '1':
+        rotation = LV_DISPLAY_ROTATION_270;
+        break;
+    case '2':
+        rotation = LV_DISPLAY_ROTATION_180;
+        break;
+    case '3':
+        rotation = LV_DISPLAY_ROTATION_90;
+        break;
+    default:
+        bbx_log(BBX_LOG_LEVEL_WARNING, "Unexpected value of /sys/class/graphics/fbcon/rotate");
+        break;
+    }
+
+    return rotation;
+}
diff --git a/shared/display.h b/shared/display.h
index 95746e3..893575b 100644
--- a/shared/display.h
+++ b/shared/display.h
@@ -34,4 +34,13 @@ typedef struct {
  */
 lv_display_t *bbx_display_create(bbx_backends_backend_id_t backend_id, bbx_display_config_t *config);
 
+/**
+ * Get the display rotation that matches the kernel's console rotation
+ * (/sys/class/graphics/fbcon/rotate). DRM drivers derive it from the panel
+ * orientation, so this corrects the UI on panels mounted sideways.
+ *
+ * @return rotation, or LV_DISPLAY_ROTATION_0 if it cannot be determined
+ */
+lv_display_rotation_t bbx_display_get_fbcon_rotation(void);
+
 #endif /* BBX_DISPLAY_H */
diff --git a/unl0kr/main.c b/unl0kr/main.c
index 44f2235..b0b2c8e 100644
--- a/unl0kr/main.c
+++ b/unl0kr/main.c
@@ -447,6 +447,13 @@ int main(int argc, char *argv[]) {
         exit_failure();
     }
 
+#if LV_USE_LINUX_FBDEV
+    /* Only the fbdev driver rotates in software; DRM would render garbage */
+    if (conf_opts.general.backend == BBX_BACKENDS_BACKEND_FBDEV) {
+        lv_display_set_rotation(disp, bbx_display_get_fbcon_rotation());
+    }
+#endif
+
     int fd_epoll = epoll_create1(EPOLL_CLOEXEC);
     if (fd_epoll == -1) {
         bbx_log(BBX_LOG_LEVEL_ERROR, "epoll_create1() is failed");
-- 
