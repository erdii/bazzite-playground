#!/bin/sh
# simpledrm's card disappears when amdgpu takes over, which would leave
# unl0kr drawing on a dead device; give the real driver up to 10s.
i=0
while [ "$i" -lt 100 ]; do
    for card in /sys/class/drm/card[0-9]*; do
        case "$card" in *-*) continue ;; esac
        case "$(readlink "$card/device/driver")" in
            "" | *simple-framebuffer*) ;;
            *) exit 0 ;;
        esac
    done
    sleep 0.1
    i=$((i + 1))
done
exit 0
