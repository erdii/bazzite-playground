From: erdii <claude@erdii.net>
Subject: [PATCH] feat(drm): support software rotation

The DRM buffers have the panel layout and are scanned out as is. When the
display is rotated, render into a separate buffer and rotate each frame
into the next DRM buffer, like the fbdev driver does.
---
--- a/lvgl/src/drivers/display/drm/lv_linux_drm.c	2026-10-13 17:30:27
+++ b/lvgl/src/drivers/display/drm/lv_linux_drm.c	2026-10-13 17:30:27
@@ -24,6 +24,7 @@
 
 #include "../../../stdlib/lv_sprintf.h"
 #include "../../../draw/lv_draw_buf.h"
+#include "../../../draw/sw/lv_draw_sw.h"
 
 #if LV_USE_LINUX_DRM_GBM_BUFFERS
     #include <gbm.h>
@@ -78,6 +79,8 @@
     drmModePropertyPtr conn_props[128];
     drm_buffer_t drm_bufs[BUFFER_CNT];
     drm_buffer_t * act_buf;
+    lv_draw_buf_t * rot_buf;
+    uint32_t rot_next;
 #if LV_USE_LINUX_DRM_GBM_BUFFERS
     struct gbm_device * gbm_device;
 #endif
@@ -117,6 +120,7 @@
 static void drm_flush(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map);
 static void drm_dmabuf_set_active_buf(lv_event_t * event);
 static void drm_del_event_cb(lv_event_t * event);
+static void drm_rotation_event_cb(lv_event_t * event);
 
 /**********************
  *  STATIC VARIABLES
@@ -154,6 +158,7 @@
     lv_display_set_flush_wait_cb(disp, drm_flush_wait);
     lv_display_set_flush_cb(disp, drm_flush);
     lv_display_add_event_cb(disp, drm_del_event_cb, LV_EVENT_DELETE, NULL);
+    lv_display_add_event_cb(disp, drm_rotation_event_cb, LV_EVENT_RESOLUTION_CHANGED, NULL);
 
     return disp;
 }
@@ -1072,6 +1077,21 @@
     LV_UNUSED(px_map);
     drm_dev_t * drm_dev = lv_display_get_driver_data(disp);
 
+    if(drm_dev->rot_buf) {
+        /* The previous flip has completed (flush_wait), so the other buffer is not scanned out */
+        drm_buffer_t * buf = &drm_dev->drm_bufs[drm_dev->rot_next];
+        lv_draw_sw_rotate(drm_dev->rot_buf->data, buf->map,
+                          drm_dev->rot_buf->header.w, drm_dev->rot_buf->header.h,
+                          drm_dev->rot_buf->header.stride, buf->pitch,
+                          lv_display_get_rotation(disp), lv_display_get_color_format(disp));
+        if(drm_dmabuf_set_plane(drm_dev, buf)) {
+            LV_LOG_ERROR("Flush fail");
+            return;
+        }
+        drm_dev->rot_next = (drm_dev->rot_next + 1) % BUFFER_CNT;
+        return;
+    }
+
     LV_ASSERT(drm_dev->act_buf != NULL);
 
     if(drm_dmabuf_set_plane(drm_dev, drm_dev->act_buf)) {
@@ -1083,6 +1103,28 @@
 
 }
 
+/* The DRM buffers have the panel's layout and are scanned out as is, so a
+ * rotated display renders into a separate buffer that drm_flush rotates into
+ * the next DRM buffer. Switching back to LV_DISPLAY_ROTATION_0 is not supported. */
+static void drm_rotation_event_cb(lv_event_t * e)
+{
+    lv_display_t * disp = lv_event_get_current_target(e);
+    drm_dev_t * drm_dev = lv_display_get_driver_data(disp);
+
+    if(drm_dev->fd < 0 || drm_dev->rot_buf || lv_display_get_rotation(disp) == LV_DISPLAY_ROTATION_0)
+        return;
+
+    drm_dev->rot_buf = lv_draw_buf_create(lv_display_get_horizontal_resolution(disp),
+                                          lv_display_get_vertical_resolution(disp),
+                                          lv_display_get_color_format(disp), LV_STRIDE_AUTO);
+    if(drm_dev->rot_buf == NULL) {
+        LV_LOG_ERROR("Failed to allocate the rotation buffer");
+        return;
+    }
+    lv_display_set_draw_buffers(disp, drm_dev->rot_buf, NULL);
+    lv_display_set_render_mode(disp, LV_DISPLAY_RENDER_MODE_DIRECT);
+}
+
 static void drm_del_event_cb(lv_event_t * e)
 {
     if(LV_EVENT_DELETE != lv_event_get_code(e))
@@ -1204,6 +1246,7 @@
         drm_dev->fd = -1;
     }
 
+    if(drm_dev->rot_buf) lv_draw_buf_destroy(drm_dev->rot_buf);
     lv_display_set_driver_data(disp, NULL);
     lv_free(drm_dev);
 }
