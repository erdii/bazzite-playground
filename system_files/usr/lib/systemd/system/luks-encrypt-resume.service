[Unit]
Description=Continue in-place disk encryption
ConditionKernelCommandLine=rd.encrypt
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/libexec/luks-encrypt-resume
Nice=19
IOSchedulingClass=idle
# systemd-cryptsetup caches the boot passphrase in root's user keyring
KeyringMode=shared

[Install]
WantedBy=multi-user.target
